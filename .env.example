PORT=8080
DATA_DIR=/data
BASE_URL=https://chat.rbyt3r.com

# Trust Cloudflare / reverse-proxy client IP headers
TRUST_PROXY=1
ALLOWED_ORIGINS=https://chat.rbyt3r.com,http://localhost:8080,http://127.0.0.1:8080

# Member caps (adjust without code changes)
MAX_LOBBY_MEMBERS=2048
MAX_PUBLIC_ROOM_MEMBERS=24
MAX_PRIVATE_ROOM_MEMBERS=12
MAX_JOINED_ROOMS=8

# Room creation anti-abuse
MAX_ROOMS_PER_IP=5
MAX_ROOMS_PER_SESSION=3
MAX_TOTAL_ROOMS=500
ROOM_CREATE_RATE_IP=3
ROOM_CREATE_IP_WINDOW=1h
ROOM_CREATE_RATE_SESSION=1
ROOM_CREATE_SESSION_WINDOW=10m
ROOM_IDLE_TTL=24h
ROOM_MAX_AGE=168h
ROOM_EVICT_INTERVAL=15m

# Connection and message limits
MAX_CONNECTIONS=200
CONN_RATE_PER_MINUTE=10
CHAT_BURST=6
CHAT_WINDOW=10s
CMD_BURST=3
CMD_WINDOW=10s
